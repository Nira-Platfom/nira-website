# ─── API connection ───────────────────────────────────────────────────────────
# Shared by the marketing site AND the business dashboard ((auth)/(dashboard)
# route groups) — they're the same app, one backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── WhatsApp ──────────────────────────────────────────────────────────────────
# Shared Nira WhatsApp number (Ghala rails) — must match backend's NIRA_WHATSAPP_NUMBER
NEXT_PUBLIC_WHATSAPP_NUMBER=255651723862

# Note: Never put secret keys in NEXT_PUBLIC_ variables.
# NEXT_PUBLIC_ variables are exposed to the browser.
